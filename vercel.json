{
  "functions": {
    "api/index.py": {
      "includeFiles": "*.py"
    }
  },
  "rewrites": [
    { "source": "/chat", "destination": "/api/index" },
    { "source": "/commitments", "destination": "/api/index" },
    { "source": "/commitments/:path*", "destination": "/api/index" },
    { "source": "/alerts", "destination": "/api/index" },
    { "source": "/alerts/:path*", "destination": "/api/index" }
  ]
}
